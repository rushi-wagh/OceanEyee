generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  password         String
  phone            String?           @unique
  profileImage     String?
  role             Role              @default(CITIZEN)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  authorityActions AuthorityAction[]
  reports          Report[]          @relation("CitizenReports")
  authorityReports Report[]          @relation("AssignedAuthority")

  @@index([role])
}

model Report {
  id                 String                @id @default(cuid())
  reportNumber       String                @unique
  title              String
  description        String
  status             ReportStatus          @default(SUBMITTED)
  latitude           Float
  longitude          Float
  locationName       String?
  citizenId          String
  currentAuthorityId String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  authorityActions AuthorityAction[]
  intelligence     IncidentIntelligence?
  citizen          User                  @relation("CitizenReports", fields: [citizenId], references: [id])
  currentAuthority User?                 @relation("AssignedAuthority", fields: [currentAuthorityId], references: [id])
  images           ReportImage[]

  @@index([status])
  @@index([citizenId])
  @@index([currentAuthorityId])
}

model ReportImage {
  id        String   @id @default(cuid())
  reportId  String
  url       String
  publicId  String
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model IncidentIntelligence {
  id                 String             @id @default(cuid())
  reportId           String             @unique
  hazardType         String?
  summary            String?
  confidence         Float?
  visionAnalysis     Json?
  nlpAnalysis        Json?
  geoAnalysis        Json?
  duplicateAnalysis  Json?
  priorityScore      Int?
  recommendation     String?
  reasoning          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  processingStatus   AIProcessingStatus @default(PENDING)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([processingStatus])
  @@index([priorityScore])
}

model AuthorityAction {
  id          String              @id @default(cuid())
  reportId    String
  authorityId String
  action      AuthorityActionType
  remarks     String?
  createdAt   DateTime            @default(now())

  authority User   @relation(fields: [authorityId], references: [id])
  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([authorityId])
}

model KnowledgeDocument {
  id        String       @id @default(cuid())
  type      DocumentType
  sourceId  String?
  title     String
  content   String
  createdAt DateTime     @default(now())
}

enum Role {
  CITIZEN
  AUTHORITY
  ADMIN
}

enum ReportStatus {
  SUBMITTED
  PENDING_AUTHORITY
  VERIFIED
  REJECTED
  RESOLVED
  CLOSED
}

enum AIProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuthorityActionType {
  VERIFIED
  RESOLVED
  CLOSED
  REJECTED
}

enum DocumentType {
  VERIFIED_REPORT
  SOP
  INCIDENT_HISTORY
  RESOLUTION_NOTE
}